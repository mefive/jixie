{
  "name": "jixie",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:docs": "pnpm --filter docs dev",
    "test:dev-shutdown": "node --test scripts/process-group.test.mjs",
    "build": "pnpm check:research-runtime && pnpm check:research-sdk && pnpm check:factor-sdk && pnpm -r build",
    "typecheck": "pnpm check:research-runtime && pnpm check:research-sdk && pnpm check:factor-sdk && pnpm -r typecheck",
    "gen:research-runtime": "node --import tsx scripts/gen-research-python-runtime.ts",
    "check:research-runtime": "node --import tsx scripts/gen-research-python-runtime.ts --check",
    "setup:research-python": "node scripts/setup-research-python.mjs",
    "gen:research-sdk": "node --import tsx scripts/gen-research-sdk.ts",
    "check:research-sdk": "node --import tsx scripts/gen-research-sdk.ts --check",
    "gen:factor-sdk": "node --import tsx scripts/gen-factor-sdk.ts",
    "check:factor-sdk": "node --import tsx scripts/gen-factor-sdk.ts --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:data": "pnpm --filter api audit:data",
    "maintenance": "./scripts/with-maintenance-lock.sh pnpm --filter api maintenance",
    "import:data": "./scripts/with-maintenance-lock.sh ./scripts/import-market-data.sh",
    "smoke": "pnpm --filter api smoke",
    "sync": "pnpm --filter api sync",
    "peek": "pnpm --filter api peek",
    "signals:run": "pnpm --filter api signals:run",
    "loc": "node scripts/loc.mjs",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.3.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.10.0"
  },
  "simple-git-hooks": {
    "pre-commit": "./scripts/run-pnpm.sh lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,yaml,yml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "isolated-vm",
      "prisma"
    ]
  }
}
