[Unit]
Description=jixie daily market-data maintenance
After=network-online.target jixie-api.service
Wants=network-online.target
StartLimitIntervalSec=6h
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=30m
User=jixie
Group=jixie
WorkingDirectory=/opt/jixie/apps/api
EnvironmentFile=/opt/jixie/apps/api/.env.production
Environment=JIXIE_MAINTENANCE_LOCK_HELD=1
ExecStart=/usr/bin/flock -n -E 75 /var/lib/jixie/maintenance.lock /usr/bin/node /opt/jixie/apps/api/dist/scripts/run-maintenance.js daily
TimeoutStartSec=6h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jixie
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jixie-maintenance
