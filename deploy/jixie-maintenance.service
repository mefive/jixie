[Unit]
Description=jixie date-targeted data synchronization
After=network-online.target jixie-api.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
Restart=on-failure
RestartSec=30m
User=jixie
Group=jixie
WorkingDirectory=/opt/jixie/apps/api
EnvironmentFile=/opt/jixie/apps/api/.env.production
ExecStart=/usr/bin/node /opt/jixie/apps/api/dist/src/maintenance/cli/data.js sync
TimeoutStartSec=35m
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jixie
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jixie-maintenance
