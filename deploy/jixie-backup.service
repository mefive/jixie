[Unit]
Description=jixie SQLite online backup and rotation
After=network.target

[Service]
Type=oneshot
User=jixie
Group=jixie
Environment=JIXIE_DB_PATH=/var/lib/jixie/prod.db
Environment=JIXIE_BACKUP_DIR=/var/backups/jixie
Environment=JIXIE_BACKUP_KEEP=2
ExecStart=/usr/bin/node /opt/jixie/apps/api/scripts/backup-db.mjs
TimeoutStartSec=6h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jixie /var/backups/jixie
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jixie-backup
