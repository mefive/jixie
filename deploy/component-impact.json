{
  "components": {
    "api": ["apps/api/"],
    "web": ["apps/web/"],
    "docs": ["apps/docs/"],
    "sandboxd": [
      "apps/sandboxd/",
      "apps/api/src/strategy/sdk/python.py",
      "apps/api/src/strategy/runtime/python/runner.py"
    ]
  },
  "allComponents": ["api", "web", "docs", "sandboxd"],
  "sharedPrefixes": ["packages/shared/"],
  "fullDeployPrefixes": ["deploy/", "scripts/"],
  "fullDeployFiles": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    ".dockerignore"
  ],
  "noRuntimePrefixes": [".github/", "docs/"],
  "noRuntimeFiles": [
    ".gitignore",
    ".prettierignore",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "ROADMAP.md"
  ]
}
