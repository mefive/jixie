FROM python:3.13.5-slim-bookworm

COPY python/requirements-research-runtime.txt /tmp/requirements-research-runtime.txt

RUN pip install --no-cache-dir --requirement /tmp/requirements-research-runtime.txt \
  && rm /tmp/requirements-research-runtime.txt \
  && useradd --system --uid 65532 --home-dir /nonexistent --shell /usr/sbin/nologin sandbox

COPY python/jixie_runner.py /opt/jixie/jixie_runner.py
COPY python/jixie_research_runtime.py /opt/jixie/jixie_research_runtime.py
COPY python/jixie_factor_runtime.py /opt/jixie/jixie_factor_runtime.py

USER 65532:65532
ENTRYPOINT ["python3", "-I", "-u", "/opt/jixie/jixie_runner.py"]
