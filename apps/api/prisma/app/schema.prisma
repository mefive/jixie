generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@jixie/app-db-client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// User
model User {
  id        String   @id // ULID
  email     String   @unique // unique identity; normalized with trim+lowercase before read/write
  name      String?
  status    String   @default("active") // 'active' | 'disabled' (disabling does not delete the account)
  createdAt DateTime @default(now())

  sessions            Session[]
  strategies          Strategy[]
  backtestReports     BacktestReport[]
  strategyScanReports StrategyScanReport[]
  agentConversations  AgentConversation[]
  embeddedAnalyses    ResearchEmbeddedAnalysis[]
  researchDocuments   ResearchDocument[]
  jobs                Job[]
}

/// Login session. id = session token (stored in sid cookie). 30-day TTL; expiry enforced by filtering on expiresAt at query time.
model Session {
  id        String   @id // ULID, i.e. the token in the cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt]) // reserved for a future cleanup job
}

/// Invite code (one-time). 12-char Crockford Base32, batch-generated by the gen-invite script.
model InviteCode {
  code        String    @id // the invite code itself is the primary key
  status      String    @default("unused") // 'unused' | 'used' | 'revoked'
  usedByEmail String? // email that consumed it
  usedAt      DateTime?
  note        String? // admin note
  createdAt   DateTime  @default(now())

  @@index([status])
}

// ============================================================================
// Factor-value pre-compute table (modeled on fangtu's derived wide tables). Each row = factor ×
// stock × rebalance date. Factor values are computed and stored across the whole market (no
// pre-filter); universe filtering is done point-in-time during the backtest.
// ============================================================================
/// One immutable factor-analysis run and its eventual result. Factor values are never stored; only
/// the normalized input, frozen factor source, status, and compact report payload are persisted.
model FactorReport {
  /// 运行时的市场版本。
  /// Market version bound to this result.
  marketVersionId    String?
  id                 String    @id // ULID for new reports; legacy composite ids remain valid
  userId             String
  factor             String
  legacyStatus       String?   @map("status") // Historical state used only without a Job.
  analysisKind       String    @default("cross_sectional") // 'cross_sectional' | 'time_series' | 'panel' | 'macro_regime'
  language           String    @default("typescript") // 'typescript' | 'python'
  runtimeVersion     String    @default("ts-v1") // 'ts-v1' | 'py-v1'
  freq               String // 'month' | 'week'
  neutral            String    @default("none") // 'none' | 'size' | 'size_industry'
  start              String // YYYYMMDD
  end                String // YYYYMMDD
  specJson           String?
  variantKey         String?
  factorCodeSnapshot String?
  factorCodeHash     String?
  dataRevision       String?
  payload            String? // JSON.stringify(FactorReport wire shape)
  failureMessage     String?   @map("error")
  createdAt          DateTime  @default(now())
  computedAt         DateTime?

  job            Job?
  approvedFactor Factor?

  @@index([userId, factor, createdAt])
  @@index([userId, variantKey])
}

/// A background computation (backtest / factor analysis). Status lives here (durable, cross-client
/// resume via a query); progress logs stream in-memory while live and are flushed to `logs` once on
/// finish (so a reopened finished job still shows them). A key ties the job to what it computes
/// (factor: variantKey, backtest: strategyId). Factor jobs are restored through factorReportId; on boot,
/// running jobs and their reports become stale. Results live on FactorReport / BacktestReport, not Job.
model Job {
  /// 提交任务时绑定的市场版本。
  /// Market version pinned at submission.
  marketVersionId      String?
  id                   String              @id // ULID
  userId               String
  kind                 String // 'backtest' | 'factor-analysis' | 'strategy-scan' | 'research-embedded-analysis'
  key                  String // dedupe/lookup key (see model doc)
  status               String // 'queued' | 'running' | 'done' | 'error' | 'stale'
  payload              Json? // Frozen runner input; required for queued jobs to survive an API restart
  error                String?
  logs                 String? // JSON(LogLine[]) — flushed once on finish; live logs stream from memory (see jobs/job-logs.ts)
  factorReportId       String?             @unique
  factorReport         FactorReport?       @relation(fields: [factorReportId], references: [id], onDelete: Cascade)
  backtestReportId     String?             @unique
  backtestReport       BacktestReport?     @relation(fields: [backtestReportId], references: [id], onDelete: Cascade)
  strategyScanReportId String?             @unique
  strategyScanReport   StrategyScanReport? @relation(fields: [strategyScanReportId], references: [id], onDelete: Cascade)
  researchExecutionId  String?             @unique
  researchExecution    ResearchExecution?  @relation(fields: [researchExecutionId], references: [id], onDelete: Cascade)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  queuedAt             DateTime            @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId, kind, key, status]) // find a user's running job for a key
}

/// Email verification challenge. Only the SHA256 of the code is stored, 10-min TTL, rejected at attempts≥5 (anti-brute-force).
model EmailLoginChallenge {
  id         String    @id // ULID = challengeId
  email      String
  inviteCode String? // only set on the registration path
  codeHash   String // SHA256(6-digit verification code)
  expiresAt  DateTime
  consumedAt DateTime? // marked after successful verification, to prevent replay
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, expiresAt])
}

// ============================================================================
// Saved user work (per-product-line persistence). Two sibling tables, one per product line — kept
// separate (not a unified table) so each column is typed to its payload. Both are owner-scoped; names
// are unique per user for display tidiness, while updates use the stable application-generated id.
// ============================================================================

/// A saved backtest strategy (holds a BacktestConfig as JSON). Created before its first Agent turn or
/// backtest, then its runnable config is committed by id whenever a backtest starts.
model Strategy {
  id              String               @id // ULID
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  config          Json // BacktestConfig
  messages        Json? // ChatMessage[] — the Agent-panel conversation that authored this strategy (per-strategy)
  conversations   AgentConversation[]
  backtestReports BacktestReport[]
  scanReports     StrategyScanReport[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([userId, name]) // name = identity within a user → enables upsert-by-name
  @@index([userId, updatedAt]) // list a user's strategies, newest first
}

/// 最近提交的回测结果及活动任务；不留存可执行源码。
/// The latest submitted backtest result and active jobs, without retained executable source.
model BacktestReport {
  /// 运行时的市场版本。
  /// Market version bound to this result.
  marketVersionId String?
  id              String    @id // ULID; migrated latest-result snapshots use a stable legacy: prefix
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId      String
  strategy        Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyName    String
  legacyStatus    String?   @map("status") // Historical state used only without a Job.
  settings        Json      @map("config") // 不含可执行源码的运行参数 / Run settings without executable source
  inputSignature  String? // 仅用于检测输出过期 / Only detects stale output
  payload         Json? // 实际回测结果 / Actual BacktestSummary
  legacyError     String?   @map("error")
  job             Job?
  createdAt       DateTime  @default(now())
  computedAt      DateTime?

  @@index([userId, strategyId, createdAt])
  @@index([userId, legacyStatus, createdAt])
}

/// 最近提交的扫描及活动任务；只保存运行参数、规格和各组合指标。
/// The latest submitted scan and active jobs retain settings, specs and per-combination metrics.
model StrategyScanReport {
  /// 运行时的市场版本。
  /// Market version bound to this result.
  marketVersionId String?
  id              String   @id // ULID
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId      String
  strategy        Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyName    String
  legacyStatus    String?  @map("status") // Historical state used only without a Job.
  settings        Json     @map("config") // 不含可执行源码的运行参数 / Run settings without executable source
  spec            Json // StrategyScanSpec
  inputSignature  String? // 仅用于检测输出过期 / Only detects stale output
  dataCutoff      String?
  payload         Json? // StrategyScanPayload
  legacyError     String?  @map("error")
  job             Job?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, strategyId, createdAt])
  @@index([userId, legacyStatus])
}

/// A factor as code (code-first, mirrors Strategy). `language` and `runtimeVersion` select the
/// compiler for the immutable definition protocol. Two kinds of rows share this table:
///   - user factors: id = ULID, userId = the owner;
///   - built-in presets: id = stable slug (ep/mom/…), userId = 'builtin' sentinel — seeded from
///     注册表只初始化缺失版本；已保存版本只读，源码升级须使用新的 key。
///     Registries initialize missing versions only; saved versions are read-only and upgrades use a new key.
/// Plain userId (no relation), like FactorReport.
model Factor {
  id               String              @id // ULID, or a preset slug for builtin rows
  userId           String
  key              String // immutable strategy handle, unique per owner
  name             String // localized display name; not a program identity
  analysisKind     String              @default("cross_sectional") // immutable definition protocol
  language         String              @default("typescript") // 'typescript' | 'python'
  runtimeVersion   String              @default("ts-v1") // 'ts-v1' | 'py-v1'
  descriptionZh    String              @default("")
  descriptionEn    String              @default("")
  code             String // TypeScript defineFactor source or Python Factor source
  messages         Json? // ChatMessage[] — the Agent-panel conversation that authored this factor (per-factor)
  status           String              @default("draft") // 'draft' | 'published' | 'archived'
  approvedReportId String?             @unique
  approvedReport   FactorReport?       @relation(fields: [approvedReportId], references: [id], onDelete: Restrict)
  codeHash         String?
  publishedAt      DateTime?
  archivedAt       DateTime?
  conversations    AgentConversation[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([userId, key]) // user-factor keys are unique per owner; builtin keys are additionally reserved in the allocator
  @@index([userId, updatedAt]) // list a user's factors, newest first
}

/// A durable Agent conversation shared by strategy, factor, and research surfaces.
model AgentConversation {
  id                String    @id // ULID
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface           String // 'strategy' | 'factor' | 'factor-question' | 'research'
  questionFactorKey String? // Stable catalog identity; private questions do not cascade with a public definition.
  title             String?
  strategyId        String?
  strategy          Strategy? @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  factorId          String?
  factor            Factor?   @relation(fields: [factorId], references: [id], onDelete: Cascade)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  messages         AgentMessage[]
  turns            AgentTurn[]
  researchDocument ResearchDocument?

  @@unique([userId, questionFactorKey])
  @@index([userId, updatedAt])
  @@index([userId, surface, updatedAt])
  @@index([strategyId])
  @@index([factorId])
}

/// One durable user-visible message. Parts remain JSON because they form one atomic render payload.
model AgentMessage {
  id             String            @id // ULID
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'user' | 'assistant'
  parts          Json // MessagePart[]
  sequence       Int
  turnId         String?
  turn           AgentTurn?        @relation(fields: [turnId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  codeChangeProposals         AgentCodeChangeProposal[]
  researchCellChangeProposals ResearchCellChangeProposal[]
  researchClarifications      ResearchClarification[]

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@index([turnId])
}

/// One durable Agent execution. `trace` is the ordered, versioned record of model, tool, and
/// validation steps; the in-memory turn bus remains responsible only for live token delivery.
model AgentTurn {
  id              String            @id // ULID; identical to the public turnId
  conversationId  String
  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status          String // 'running' | 'done' | 'error' | 'cancelled' | 'interrupted'
  model           String
  trace           Json
  contextSnapshot Json? // Immutable server-resolved context for a Factor question.
  error           String?
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?

  messages                    AgentMessage[]
  codeChangeProposals         AgentCodeChangeProposal[]
  researchCellChangeProposals ResearchCellChangeProposal[]
  researchClarifications      ResearchClarification[]

  @@index([conversationId, startedAt])
  @@index([status, startedAt])
}

/// One reactive research document attached to the same conversation used by the Research Agent.
model ResearchDocument {
  id              String            @id // ULID; currently identical to conversationId
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId  String            @unique
  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runtimeVersion  String            @default("research-py-v1")
  contentRevision Int               @default(1)
  embeddedRunKey  String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  embeddedVersion     ResearchEmbeddedAnalysisVersion?
  cells               ResearchCell[]
  executions          ResearchCellExecution[]
  researchExecutions  ResearchExecution[]
  artifacts           ResearchArtifact[]
  cellChangeProposals ResearchCellChangeProposal[]
  cellChangeAttempts  ResearchCellChangeAttempt[]
  clarifications      ResearchClarification[]

  @@index([userId, updatedAt])
}

/// One ordered Markdown or Python cell. Dependency metadata is derived from Python AST
/// analysis; the latest output is a convenience view backed by immutable execution snapshots.
model ResearchCell {
  id                   String           @id // ULID
  documentId           String
  document             ResearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position             Int
  kind                 String // 'markdown' | 'python'
  source               String
  config               Json?
  status               String           @default("idle") // 'idle' | 'running' | 'success' | 'error' | 'stale' | 'blocked'
  revision             Int              @default(1)
  definitions          Json
  references           Json
  dependencyIssues     Json             @default("[]")
  output               Json?
  lastExecutedRevision Int?
  lastExecutedAt       DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  executions ResearchCellExecution[]

  @@unique([documentId, position])
  @@index([documentId, updatedAt])
}

/// Cell 的当前运行诊断或提案尝试输出，不留存源码、环境或输入响应。
/// Current cell diagnostics or proposal attempt outputs; no source, environment or input-response archive.
model ResearchCellExecution {
  id                  String                     @id // ULID
  documentId          String
  document            ResearchDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  cellId              String?
  cell                ResearchCell?              @relation(fields: [cellId], references: [id], onDelete: SetNull)
  sourceCellId        String?
  sourcePosition      Int?
  sourceKind          String?
  revision            Int
  status              String // 'running' | 'success' | 'error' | 'cancelled'; embedded runs may also be 'queued'
  output              Json?
  error               String?
  definitions         Json
  references          Json
  startedAt           DateTime                   @default(now())
  finishedAt          DateTime?
  cellChangeAttemptId String?
  cellChangeAttempt   ResearchCellChangeAttempt? @relation(fields: [cellChangeAttemptId], references: [id], onDelete: SetNull)
  researchExecutionId String?
  researchExecution   ResearchExecution?         @relation(fields: [researchExecutionId], references: [id], onDelete: SetNull)

  @@index([documentId, startedAt])
  @@index([cellId, startedAt])
  @@index([sourceCellId, startedAt])
  @@index([cellChangeAttemptId, startedAt])
  @@index([researchExecutionId, startedAt])
}

/// 嵌入式分析的排队、幂等和当前结果状态；普通文档不再创建此记录。
/// Queue, idempotency and current result state for embedded analyses; ordinary documents do not create these rows.
model ResearchExecution {
  /// 运行时的市场版本。
  /// Market version bound to this result.
  marketVersionId String?
  id              String           @id // ULID
  documentId      String
  document        ResearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sequence        Int
  contentRevision Int
  status          String           @default("running") // 'running' | 'success' | 'error' | 'cancelled'; embedded executions may also be 'queued'
  error           String?
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?

  embeddedVersionId String?
  embeddedVersion   ResearchEmbeddedAnalysisVersion? @relation(fields: [embeddedVersionId], references: [id], onDelete: Restrict)
  requestId         String?
  errorCode         String?
  job               Job?

  cellExecutions ResearchCellExecution[]

  @@unique([embeddedVersionId, requestId])
  @@unique([documentId, sequence])
  @@index([embeddedVersionId, startedAt])
  @@index([documentId, startedAt])
}

/// 归属于文档的图片，独立于执行诊断记录保留，并通过鉴权接口读取。
/// Document-owned images survive execution diagnostics deletion and require authenticated reads.
model ResearchArtifact {
  id         String           @id // ULID
  documentId String
  document   ResearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind       String // 'image'
  mimeType   String // 'image/png' | 'image/svg+xml'
  data       Bytes
  byteSize   Int
  sha256     String
  width      Int?
  height     Int?
  createdAt  DateTime         @default(now())

  @@index([documentId, createdAt])
  @@index([sha256])
}

/// One Agent-authored batch of Cell edits awaiting explicit user application. Operations retain
/// before/after source and optimistic revisions so the proposal remains auditable after resolution.
model ResearchCellChangeProposal {
  id                              String           @id // ULID
  documentId                      String
  document                        ResearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceTurnId                    String
  sourceTurn                      AgentTurn        @relation(fields: [sourceTurnId], references: [id], onDelete: Cascade)
  sourceMessageId                 String
  sourceMessage                   AgentMessage     @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  sourcePartIndex                 Int
  title                           String
  summary                         String
  expectedDocumentUpdatedAt       DateTime
  expectedDocumentContentRevision Int?
  appliedDocumentContentRevision  Int?
  reviewSessionId                 String?
  reviewSequence                  Int?
  reviewStatus                    String? // 'open' | 'accepted' | 'reverted'
  reviewIsLatest                  Boolean          @default(false)
  reviewResolvedAt                DateTime?
  operations                      Json
  status                          String           @default("pending") // 'pending' | 'applied' | 'rejected' | 'conflicted'
  conflict                        Json?
  createdAt                       DateTime         @default(now())
  resolvedAt                      DateTime?

  attempts ResearchCellChangeAttempt[]

  @@unique([sourceMessageId, sourcePartIndex])
  @@index([documentId, status, createdAt])
  @@index([documentId, reviewStatus, createdAt])
  @@index([reviewSessionId, reviewSequence])
  @@index([sourceTurnId])
}

/// One structured Agent question that records semantic choices independently from message JSON.
/// The source message part mirrors this row so refreshes preserve pending and answered state.
model ResearchClarification {
  id              String           @id // ULID
  documentId      String
  document        ResearchDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sourceTurnId    String
  sourceTurn      AgentTurn        @relation(fields: [sourceTurnId], references: [id], onDelete: Cascade)
  sourceMessageId String
  sourceMessage   AgentMessage     @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  sourcePartIndex Int
  title           String
  questions       Json
  status          String           @default("pending") // 'pending' | 'answered' | 'superseded'
  answer          Json?
  createdAt       DateTime         @default(now())
  answeredAt      DateTime?

  @@unique([sourceMessageId, sourcePartIndex])
  @@index([documentId, status, createdAt])
  @@index([sourceTurnId])
}

/// One user-authorized execution of an applied Agent Cell-change proposal. It groups immutable
/// Cell execution snapshots without promoting exploratory work to a formal ResearchExecution.
model ResearchCellChangeAttempt {
  id                String                     @id // ULID
  documentId        String
  document          ResearchDocument           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  proposalId        String
  proposal          ResearchCellChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  contentRevision   Int
  scope             String // 'affected' | 'clean_document'
  rootCellIds       Json
  plannedCellIds    Json
  status            String                     @default("running") // 'running' | 'success' | 'error' | 'cancelled'
  error             String?
  explanationTurnId String?
  startedAt         DateTime                   @default(now())
  finishedAt        DateTime?

  executions ResearchCellExecution[]

  @@index([documentId, startedAt])
  @@index([proposalId, startedAt])
}

/// A bounded, read-only observation of one versioned Tushare capability. Samples are deliberately
/// excluded: probes retain only availability, schema, permission and observed history metadata.
model TushareCapabilityProbe {
  id             String   @id // ULID
  catalogVersion Int
  apiName        String
  domain         String
  probeDate      String
  status         String
  rowCount       Int
  fields         Json
  historyField   String?
  historyStart   String?
  historyEnd     String?
  probeCoverage  String?
  errorCode      Int?
  errorMessage   String?
  probedAt       DateTime

  @@index([apiName, probedAt])
  @@index([probedAt])
}

/// A private question anchored to a Factor or Strategy. Host identifiers are snapshots rather than
/// cascading foreign keys: deleting or publishing a host must not delete or expose its evidence.
model ResearchEmbeddedAnalysis {
  id          String                            @id
  userId      String
  user        User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostType    String
  hostId      String
  title       String
  nextVersion Int                               @default(1)
  activeRunId String?                           @unique
  versions    ResearchEmbeddedAnalysisVersion[]
  createdAt   DateTime                          @default(now())
  updatedAt   DateTime                          @updatedAt

  @@index([userId, hostType, hostId, updatedAt])
}

/// 可编辑的嵌入式 Python 草稿，保留宿主及可选报告 ID，不因成功运行冻结。
/// Editable embedded Python draft with a host and optional report ID; successful runs do not freeze it.
model ResearchEmbeddedAnalysisVersion {
  id              String                            @id
  analysisId      String
  analysis        ResearchEmbeddedAnalysis          @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  number          Int
  parentVersionId String?
  parentVersion   ResearchEmbeddedAnalysisVersion?  @relation("EmbeddedVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  derivedVersions ResearchEmbeddedAnalysisVersion[] @relation("EmbeddedVersionParent")
  documentId      String                            @unique
  document        ResearchDocument                  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  source          String
  parameters      Json
  inputScope      String
  reportId        String?
  revision        Int                               @default(1)
  executions      ResearchExecution[]
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt

  @@unique([analysisId, number])
}

/// 独立保存 Agent 待审代码；只在用户接受后更新业务对象。
/// Retain Agent code suggestions separately; mutate the host only on explicit acceptance.
model AgentCodeChangeProposal {
  id              String       @id
  userId          String
  surface         String
  entityId        String
  sourceTurnId    String
  sourceTurn      AgentTurn    @relation(fields: [sourceTurnId], references: [id], onDelete: Cascade)
  sourceMessageId String
  sourceMessage   AgentMessage @relation(fields: [sourceMessageId], references: [id], onDelete: Cascade)
  language        String
  baseIdentity    String
  beforeCode      String
  afterCode       String
  status          String       @default("pending")
  createdAt       DateTime     @default(now())
  acceptedAt      DateTime?

  @@unique([sourceTurnId])
  @@index([userId, surface, entityId, createdAt])
}

/// 市场版本；父版本与父发布序号一并校验，避免回退再前进时误用旧基线。
/// Persist each market version and its parent publication sequence for baseline checks.
model MarketVersion {
  retained          Boolean   @default(false)
  historyVersionId  String?
  isBaseline        Boolean   @default(false)
  targetDate        String
  trigger           String    @default("manual")
  createdAt         DateTime  @default(now())
  readyAt           DateTime?
  finishedAt        DateTime?
  rejectionReason   String?
  id                String    @id
  runId             String    @unique
  parentVersionId   String?
  parentSequence    Int
  selectionVersion  Int
  phase             String
  activeSlot        Int?      @unique
  operation         String?
  candidateVersion  String?
  publishedAt       DateTime?
  publishedRevision Int?
}

/// 市场读取入口；单行更新与发布凭据在同一应用库事务提交。
/// The active version pointer commits alongside its publication receipt.
model MarketPublication {
  key               String  @id
  currentVersionId  String?
  previousVersionId String?
  sequence          Int     @default(0)
  selectionVersion  Int     @default(0)
}

/// 名单编辑仅作用于之后的候选；sequence 与应用库配置修订同事务增加。
/// Apply administrator edits to subsequent candidates, advancing configuration sequence atomically.
model MarketSelectionEdit {
  sequence  Int      @id
  assetType String
  added     Json
  removed   Json
  createdAt DateTime @default(now())
}

/// 显式回退的持久凭据，sequence 与指针同事务提交。
/// Record explicit rollback and pointer sequence in one transaction.
model MarketRollback {
  sequence      Int      @id
  fromVersionId String
  toVersionId   String
  createdAt     DateTime @default(now())
}
