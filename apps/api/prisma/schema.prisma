generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Market base data. Field names use camelCase (Prisma convention), converted from Tushare's
// snake_case on ingest. Primary key is "code + trade date", which together with
// "delete the day first, then createMany" makes repeatable syncs idempotent.
// ============================================================================

/// Stock list across listed, delisted, suspended-listing, and approved-but-not-yet-traded statuses.
model StockBasic {
  tsCode     String  @id
  symbol     String
  name       String
  area       String?
  industry   String?
  market     String?
  listDate   String?
  delistDate String?
  listStatus String
}

/// Exchange-confirmed security-code succession. Market tables use `newTsCode` as their canonical
/// storage identity; this table preserves the old identity and its effective-date boundary.
model StockCodeChange {
  oldTsCode     String @id
  newTsCode     String
  effectiveDate String
  source        String

  @@index([newTsCode])
}

/// Point-in-time stock-name spell from Tushare namechange. Risk-warning and delisting-period states
/// are derived from the historical name that covers the evaluated date, never from today's name.
model StockNameHistory {
  tsCode           String
  name             String
  startDate        String
  endDate          String?
  announcementDate String?
  changeReason     String?

  @@id([tsCode, startDate])
  @@index([tsCode, endDate])
  @@index([announcementDate])
}

/// Shenwan (SW2021) level-1 industry membership, point-in-time. One row per (stock, industry, spell):
/// the stock belonged to `l1Name` from `inDate` up to (but excluding) `outDate` (null = still a member).
/// Used for industry-neutralization in factor analysis — pick the spell covering the rebalance date.
/// A stock can have several spells (it moved industries) so the membership is keyed by inDate too.
model SwIndustryMember {
  tsCode  String
  l1Code  String // SW level-1 industry index code, e.g. 801120.SI
  l1Name  String // SW level-1 industry name, e.g. 食品饮料
  inDate  String // date the stock entered this industry (YYYYMMDD)
  outDate String? // date it left (YYYYMMDD); null = current member

  @@id([tsCode, l1Code, inDate])
  @@index([tsCode])
}

/// Trading calendar
model TradeCal {
  exchange     String
  calDate      String
  isOpen       Int
  pretradeDate String?

  @@id([exchange, calDate])
}

/// Daily bars (unadjusted). Backtests derive backward-adjusted (hfq) prices via close × adjFactor.
model Daily {
  tsCode    String
  tradeDate String
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  preClose  Float?
  pctChg    Float?
  vol       Float?
  amount    Float?

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Adjustment factor
model AdjFactor {
  tsCode    String
  tradeDate String
  adjFactor Float

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// ETF metadata. Listed and delisted funds are both retained so historical ETF research does not
/// acquire survivorship bias. `sameDayTurnover` records whether secondary-market units may be sold
/// on the purchase day under the fund category's exchange rule.
model EtfBasic {
  tsCode          String  @id
  name            String
  fullName        String?
  indexCode       String?
  indexName       String?
  setupDate       String?
  listDate        String?
  delistDate      String?
  listStatus      String
  exchange        String
  managerName     String?
  custodianName   String?
  managementFee   Float?
  fundType        String?
  etfType         String?
  sameDayTurnover Boolean
  lotSize         Int     @default(100)
}

/// ETF daily bars (unadjusted). Kept separate from stock Daily because stock day-refreshes replace
/// all stock rows for a date. Tushare volume is in lots and amount is in thousand yuan.
model EtfDaily {
  tsCode    String
  tradeDate String
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  preClose  Float?
  pctChg    Float?
  vol       Float?
  amount    Float?

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// ETF adjustment factor. After-adjustment ETF price = raw price × adjFactor.
model EtfAdjFactor {
  tsCode    String
  tradeDate String
  adjFactor Float

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Completion marker for an atomically refreshed ETF code/year slice. This makes long backfills
/// resumable without guessing completeness from sparse trading rows.
model EtfSyncSlice {
  tsCode      String
  startDate   String
  endDate     String
  completedAt DateTime @default(now())

  @@id([tsCode, startDate, endDate])
}

/// Daily price limits (unadjusted up/down limit prices). The engine blocks buys at the up-limit open and sells at
/// the down-limit open (covers board-specific limits: Main Board ±10 / ST ±5 / ChiNext & STAR ±20 / BSE ±30).
model StkLimit {
  tsCode    String
  tradeDate String
  upLimit   Float // up-limit price (raw)
  downLimit Float // down-limit price (raw)

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Dragon-Tiger List: stocks with abnormal activity that day + their net buy. Sparse event data
/// (only listed stocks have a row that day) — read exact-date via ctx.lhbNet, never carried forward.
model TopList {
  tsCode    String
  tradeDate String
  netAmount Float // Dragon-Tiger List net buy amount (yuan), summed across that day's listings

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Daily per-stock moneyflow (Tushare moneyflow). Raw fetched point-in-time data — read exact-date via
/// ctx.moneyflow, never carried forward. Net amounts in 10k yuan (+ net inflow / − net outflow).
model Moneyflow {
  tsCode    String
  tradeDate String
  netMain   Float // main-force net amount = (large + extra-large orders) buy − sell, 10k yuan
  netTotal  Float? // net amount across all order sizes (net_mf_amount), 10k yuan — source may omit it

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Daily valuation metrics (point-in-time by construction). Unlocks value/dividend/size factors.
model DailyBasic {
  tsCode        String
  tradeDate     String
  pe            Float?
  peTtm         Float?
  pb            Float?
  ps            Float?
  psTtm         Float?
  dvRatio       Float? // dividend yield %
  dvTtm         Float?
  totalMv       Float? // total market cap (10k yuan)
  circMv        Float? // circulating market cap (10k yuan)
  turnoverRate  Float?
  turnoverRateF Float? // turnover rate based on free-float shares (%)

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Financial indicators per report period (point-in-time via annDate). Unlocks ROE/quality factors.
/// ROE is cumulative within a year; annual reports end in 1231. The same period can appear multiple
/// times (restatements) — sync keeps the latest annDate per (tsCode, endDate).
model FinaIndicator {
  tsCode            String
  endDate           String // report period end, e.g. 20231231
  annDate           String? // announcement date — the PIT gate (value is only public on/after this)
  roe               Float? // return on equity %
  roeWaa            Float? // weighted-average return on equity %
  roa               Float? // return on assets %
  grossprofitMargin Float? // gross profit margin %
  netprofitMargin   Float? // net profit margin %
  debtToAssets      Float? // debt-to-assets ratio %
  orYoy             Float? // operating revenue YoY growth %
  netprofitYoy      Float? // net profit attributable to parent, YoY growth %
  ocfToProfit       Float? // operating cash flow / operating profit (accrual quality)

  @@id([tsCode, endDate])
  @@index([annDate])
}

/// Dividend distributions (raw; a period yields several rows across proposal→execution stages).
/// Only divProc '实施' (the "implemented" stage) is an actually-paid dividend; exDate is the PIT gate for when it took effect.
model Dividend {
  id         String  @id // ULID — no natural unique key (multiple rows per period)
  tsCode     String
  endDate    String // distribution's report period
  annDate    String? // announcement date
  exDate     String? // ex-dividend date (PIT gate)
  divProc    String? // distribution stage (raw Chinese values from source): '预案' | '股东大会通过' | '实施' | ...
  cashDiv    Float? // pre-tax cash dividend per share
  cashDivTax Float? // per-share figure incl. proposal stage

  @@index([tsCode])
}

/// Index constituents over time (monthly snapshots from index_weight). Used for point-in-time
/// universe membership (e.g. breadth over CSI 1000 = 000852.SH as-of each date).
model IndexWeight {
  indexCode String
  conCode   String
  tradeDate String // snapshot date (month-end)
  weight    Float?

  @@id([indexCode, conCode, tradeDate])
  @@index([indexCode, tradeDate])
}

/// Index daily close (e.g. CSI 300 = 000300.SH) — benchmark return curve + future regime filter.
model IndexDaily {
  tsCode    String
  tradeDate String
  close     Float

  @@id([tsCode, tradeDate])
}

/// Daily valuation metrics for broad-market indices. Values come from Tushare index_dailybasic
/// rather than being reconstructed from constituent stock PEs, so provider methodology is preserved.
model IndexDailyBasic {
  tsCode        String
  tradeDate     String
  totalMv       Float? // total market cap (yuan)
  floatMv       Float? // float market cap (yuan)
  totalShare    Float? // total shares
  floatShare    Float? // float shares
  freeShare     Float? // free-float shares
  turnoverRate  Float? // turnover rate (%)
  turnoverRateF Float? // free-float turnover rate (%)
  pe            Float?
  peTtm         Float?
  pb            Float?

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Official public-fund benchmark catalog from Tushare mkt_idx_bmk. The type fields distinguish
/// broad, style, strategy, industry, and thematic indices without inferring categories from names.
model IndexBenchmark {
  tsCode    String @id
  symbol    String
  name      String
  fullName  String
  bmkLevel  String
  bmkType   String
  bmkSource String
  indexType String
}

/// Official Shenwan index daily bars. Only SW2021 level-1 industries from index_classify are stored,
/// so broad Shenwan indices and level-2/level-3 industries cannot leak into the industry dashboard.
model SwIndexDaily {
  tsCode    String
  tradeDate String
  name      String
  open      Float?
  low       Float?
  high      Float?
  close     Float?
  change    Float?
  pctChange Float? // percent
  volume    Float? // 10k shares
  amount    Float? // 10k CNY
  pe        Float?
  pb        Float?
  floatMv   Float? // 10k CNY
  totalMv   Float? // 10k CNY

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Precomputed whole-market daily state. Values are descriptive measurements, not forecasts:
/// activity, participation breadth, trend, concentration, and speculative extremes. Price-window
/// fields use adjusted closes and only stocks with sufficient point-in-time history enter each
/// denominator.
model MarketIndicator {
  tradeDate                 String @id
  tradedCount               Int
  return20                  Float?
  advanceRatio              Float?
  aboveMa20Ratio            Float?
  aboveMa60Ratio            Float?
  totalAmount               Float?
  floatWeightedTurnoverRate Float?
  topFivePercentAmountShare Float?
  extremeMoveRatio          Float?
  limitUpCount              Int
  limitDownCount            Int
}

/// Precomputed point-in-time index-universe state. Each trading day uses the latest constituent
/// snapshot available on or before that date, so historical breadth and activity do not use today's
/// members. return20 follows the official index close; the remaining fields aggregate constituents.
/// peTtm and pb are constituent-derived valuation proxies, not official index-provider metrics.
model IndexIndicator {
  indexCode                 String
  tradeDate                 String
  membershipDate            String
  tradedCount               Int
  return20                  Float?
  advanceRatio              Float?
  aboveMa20Ratio            Float?
  aboveMa60Ratio            Float?
  totalAmount               Float?
  floatWeightedTurnoverRate Float?
  peTtm                     Float?
  pb                        Float?
  valuationCoverage         Float?
  topFivePercentAmountShare Float?
  extremeMoveRatio          Float?
  limitUpCount              Int
  limitDownCount            Int

  @@id([indexCode, tradeDate])
  @@index([tradeDate])
}

/// Precomputed Shenwan level-1 industry state using the membership spell valid on each trade date.
/// Industry heat is assembled at read time from trend, breadth, and activity percentiles so every
/// component remains visible and independently interpretable.
model IndustryIndicator {
  l1Code                    String
  l1Name                    String
  tradeDate                 String
  tradedCount               Int
  return20                  Float?
  excessReturn20            Float?
  positiveReturn20Ratio     Float?
  aboveMa20Ratio            Float?
  aboveMa60Ratio            Float?
  floatWeightedTurnoverRate Float?
  amountShare               Float?
  topFiveAmountShare        Float?

  @@id([l1Code, tradeDate])
  @@index([tradeDate])
}

/// CFFEX stock-index futures contracts. Only IF/IH/IC/IM actual delivery-month contracts are stored;
/// continuous symbols (e.g. IF.CFX) live in FutureMapping and must never be treated as tradable contracts.
model FutureContract {
  tsCode           String  @id // actual contract code, e.g. IF2509.CFX
  symbol           String
  productCode      String // IF / IH / IC / IM
  name             String
  exchange         String // CFFEX
  multiplier       Float // CNY per index point
  tradeUnit        String?
  perUnit          Float?
  quoteUnit        String?
  quoteUnitDesc    String?
  deliveryMode     String?
  listDate         String
  delistDate       String
  deliveryMonth    String?
  lastDeliveryDate String?
  tradeTimeDesc    String?

  @@index([productCode])
  @@index([listDate, delistDate])
}

/// Raw daily bars for actual CFFEX stock-index futures contracts. Prices are index points; volume and
/// open interest are contracts. Settlement price, rather than close, is the daily variation-margin basis.
model FutureDaily {
  tsCode             String
  tradeDate          String
  preClose           Float?
  preSettle          Float?
  open               Float?
  high               Float?
  low                Float?
  close              Float?
  settle             Float?
  changeClose        Float? // close - previous settlement
  changeSettle       Float? // settlement - previous settlement
  volume             Float?
  amount             Float? // 10k yuan
  openInterest       Float?
  openInterestChange Float?
  deliverySettle     Float?

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

/// Point-in-time mapping from a logical main/continuous symbol (e.g. IF.CFX) to an actual contract.
/// Signals may use an adjusted continuous series, but fills must always use mappedTsCode.
model FutureMapping {
  continuousCode String
  tradeDate      String
  mappedTsCode   String

  @@id([continuousCode, tradeDate])
  @@index([tradeDate])
  @@index([mappedTsCode])
}

/// Historical exchange settlement parameters. Broker margin add-ons are account-specific and must be
/// layered on top later; these rows preserve the source values instead of hard-coding today's rates.
model FutureSettlement {
  tsCode              String
  tradeDate           String
  settle              Float?
  tradingFeeRate      Float?
  tradingFee          Float?
  deliveryFee         Float?
  buyHedgeMarginRate  Float?
  sellHedgeMarginRate Float?
  longMarginRate      Float?
  shortMarginRate     Float?
  closeTodayFee       Float?
  exchange            String?

  @@id([tsCode, tradeDate])
  @@index([tradeDate])
}

// ============================================================================
// Production maintenance coordination. The operating-system flock is the strong cross-process lock;
// these rows provide durable progress, retry semantics, publication watermarks, and the App gate.
// They are operational metadata and must never be exposed through the Agent read-only SQL tool.
// ============================================================================

/// One idempotent daily, weekly, repair, or deployment maintenance run.
model MaintenanceRun {
  id          String    @id // ULID
  kind        String // 'daily' | 'weekly' | 'repair' | 'deploy'
  targetKey   String
  startDate   String?
  endDate     String?
  trigger     String // 'timer' | 'manual'
  status      String // 'running' | 'done' | 'error'
  stage       String
  attempts    Int       @default(1)
  summary     Json?
  error       String?
  heartbeatAt DateTime  @default(now())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([kind, targetKey])
  @@index([status, updatedAt])
}

/// Durable per-item progress for long maintenance stages. Failed or killed runs keep checkpoints
/// so the retry can resume; a successful run removes them after recording its terminal state.
model MaintenanceCheckpoint {
  runId       String
  stage       String
  itemKey     String
  completedAt DateTime @default(now())

  @@id([runId, stage, itemKey])
  @@index([runId, stage])
}

/// Singleton publication state. `dailyPublishedThrough` is a continuous SSE trading-day watermark.
model MaintenanceState {
  key                   String   @id
  dailyPublishedThrough String?
  weeklySyncedThrough   String?
  dataRevision          Int      @default(0)
  updatedAt             DateTime @updatedAt
}

// ============================================================================
// User system (invite-only beta). Passwordless: log in with email + 6-digit verification code;
// registering a new email requires a one-time invite code.
// Sessions use an opaque DB session id stored in the sid cookie (not JWT); logout deletes the row
// for instant invalidation. Design borrowed from marginalia / fangtu apps/api. IDs are
// application-generated ULIDs.
// ============================================================================

/// User
model User {
  id        String   @id // ULID
  email     String   @unique // unique identity; normalized with trim+lowercase before read/write
  name      String?
  status    String   @default("active") // 'active' | 'disabled' (disabling does not delete the account)
  createdAt DateTime @default(now())

  sessions            Session[]
  strategies          Strategy[]
  strategyScanReports StrategyScanReport[]
  strategyDeployments StrategyDeployment[]
  signalRuns          SignalRun[]
  signalExecutions    SignalExecution[]
  accountSnapshots    StrategyAccountSnapshot[]
  savedScreens        SavedScreen[]
  screenConversations ScreenConversation[]
  agentConversations  AgentConversation[]
  factorComposites    FactorComposite[]
  factorWeatherPins   FactorWeatherPin[]
  factorReleases      FactorRelease[]
}

/// Login session. id = session token (stored in sid cookie). 30-day TTL; expiry enforced by filtering on expiresAt at query time.
model Session {
  id        String   @id // ULID, i.e. the token in the cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt]) // reserved for a future cleanup job
}

/// Invite code (one-time). 12-char Crockford Base32, batch-generated by the gen-invite script.
model InviteCode {
  code        String    @id // the invite code itself is the primary key
  status      String    @default("unused") // 'unused' | 'used' | 'revoked'
  usedByEmail String? // email that consumed it
  usedAt      DateTime?
  note        String? // admin note
  createdAt   DateTime  @default(now())

  @@index([status])
}

// ============================================================================
// Factor-value pre-compute table (modeled on fangtu's derived wide tables). Each row = factor ×
// stock × rebalance date. Factor values are computed and stored across the whole market (no
// pre-filter); universe filtering is done point-in-time during the backtest.
// ============================================================================
/// One immutable factor-analysis run and its eventual result. Factor values are never stored; only
/// the normalized input, frozen factor source, status, and compact report payload are persisted.
model FactorReport {
  id                 String    @id // ULID for new reports; legacy composite ids remain valid
  userId             String
  factor             String
  status             String    @default("done") // 'running' | 'done' | 'error' | 'stale'
  phase              String    @default("legacy") // 'legacy' | 'explore' | 'holdout'
  analysisKind       String    @default("cross_sectional") // 'cross_sectional' | 'time_series' | 'panel' | 'macro_regime'
  freq               String // 'month' | 'week'
  neutral            String    @default("none") // 'none' | 'size' | 'size_industry'
  start              String // YYYYMMDD
  end                String // YYYYMMDD
  specJson           String?
  variantKey         String?
  factorCodeSnapshot String?
  factorCodeHash     String?
  dataRevision       String?
  payload            String? // JSON.stringify(FactorReport wire shape)
  error              String?
  parentReportId     String?
  testKey            String?
  researchIntentJson String?
  holdoutPolicyJson  String?
  revealedAt         DateTime?
  createdAt          DateTime  @default(now())
  computedAt         DateTime?

  job      Job?
  releases FactorRelease[]

  @@index([userId, factor, createdAt])
  @@index([userId, variantKey])
  @@index([userId, testKey])
  @@index([userId, parentReportId, phase])
}

/// Cached factor-correlation report (3.4). Payload = JSON FactorCorrelation wire shape. id encodes the
/// user + sorted factor keys + freq + window, so the same request hits the cache regardless of key order.
model FactorCorrelation {
  id         String   @id // `${userId}|${sortedKeys.join(',')}|${freq}|${start}|${end}`
  userId     String
  payload    String
  computedAt DateTime

  @@index([userId])
}

/// A background computation (backtest / factor analysis). Status lives here (durable, cross-client
/// resume via a query); progress logs stream in-memory while live and are flushed to `logs` once on
/// finish (so a reopened finished job still shows them). A key ties the job to what it computes
/// (factor: variantKey, backtest: strategyId). Factor jobs are restored through factorReportId; on boot,
/// running jobs and their reports become stale. Results live on FactorReport / Strategy, not Job.
model Job {
  id                   String              @id // ULID
  userId               String
  kind                 String // 'backtest' | 'factor' | 'strategy-scan' | 'signal'
  key                  String // dedupe/lookup key (see model doc)
  status               String // 'running' | 'done' | 'error' | 'stale'
  error                String?
  logs                 String? // JSON(LogLine[]) — flushed once on finish; live logs stream from memory (see lib/jobs.ts)
  factorReportId       String?             @unique
  factorReport         FactorReport?       @relation(fields: [factorReportId], references: [id], onDelete: Cascade)
  strategyScanReportId String?             @unique
  strategyScanReport   StrategyScanReport? @relation(fields: [strategyScanReportId], references: [id], onDelete: Cascade)
  signalRunId          String?
  signalRun            SignalRun?          @relation(fields: [signalRunId], references: [id], onDelete: Cascade)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId, kind, key, status]) // find a user's running job for a key
  @@index([signalRunId, createdAt])
}

/// Email verification challenge. Only the SHA256 of the code is stored, 10-min TTL, rejected at attempts≥5 (anti-brute-force).
model EmailLoginChallenge {
  id         String    @id // ULID = challengeId
  email      String
  inviteCode String? // only set on the registration path
  codeHash   String // SHA256(6-digit verification code)
  expiresAt  DateTime
  consumedAt DateTime? // marked after successful verification, to prevent replay
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, expiresAt])
}

// ============================================================================
// Saved user work (per-product-line persistence). Two sibling tables, one per product line — kept
// separate (not a unified table) so each column is typed to its payload. Both are owner-scoped; names
// are unique per user for display tidiness, while updates use the stable application-generated id.
// ============================================================================

/// A saved backtest strategy (holds a BacktestConfig as JSON). Created before its first Agent turn or
/// backtest, then its runnable config is committed by id whenever a backtest starts.
model Strategy {
  id            String               @id // ULID
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  config        Json // BacktestConfig
  lastResult    Json? // last BacktestSummary (metrics + nav + tradeLog) — shown on reopen, refreshed each run
  messages      Json? // ChatMessage[] — the Agent-panel conversation that authored this strategy (per-strategy)
  conversations AgentConversation[]
  scanReports   StrategyScanReport[]
  deployments   StrategyDeployment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([userId, name]) // name = identity within a user → enables upsert-by-name
  @@index([userId, updatedAt]) // list a user's strategies, newest first
}

/// One immutable strategy version promoted from research into daily operation. Editing Strategy.config
/// never mutates an active deployment; a changed code/config/cost snapshot requires an explicit redeploy.
model StrategyDeployment {
  id               String                    @id // ULID
  userId           String
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId       String
  strategy         Strategy                  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyName     String
  status           String // 'active' | 'paused'
  config           Json // frozen BacktestConfig
  factorReleases   Json? // frozen FactorReleaseDependency[] used by this deployment
  codeHash         String
  locale           String // 'zh' | 'en', frozen for scheduler-generated notifications
  deployedAt       DateTime                  @default(now())
  stoppedAt        DateTime?
  signalRuns       SignalRun[]
  accountSnapshots StrategyAccountSnapshot[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([userId, status])
  @@index([strategyId, status])
}

/// One durable next-open signal set generated from a deployment and one market close. Retries reuse
/// the same row, while every computation attempt has its own Job for logs and stale recovery.
model SignalRun {
  id                String             @id // ULID
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deploymentId      String
  deployment        StrategyDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  strategyId        String
  tradeDate         String // signal is based on this market close (YYYYMMDD)
  execDate          String // intended next open (YYYYMMDD)
  status            String // 'running' | 'done' | 'error' | 'stale'
  factorReleases    Json? // deployment release dependencies copied when this run is created
  factorInputs      Json? // FactorInputSummary[] consumed on the final decision bar
  dataCutoff        String?
  modelEquity       Float?
  modelCash         Float?
  modelPositions    Json? // ModelPositionSnapshot[] at the signal close; seeds forward account tracking
  signals           Json? // SignalItem[]
  error             String?
  notifiedAt        DateTime?
  notificationError String?
  jobs              Job[]
  executions        SignalExecution[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([deploymentId, tradeDate])
  @@index([userId, tradeDate])
  @@index([strategyId, tradeDate])
  @@index([status])
}

/// One immutable signal instruction plus its simulated fill and user-entered real execution. The
/// instruction columns are copied out of SignalRun.signals so cross-day execution quality is queryable.
model SignalExecution {
  id                String    @id // ULID
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  signalRunId       String
  signalRun         SignalRun @relation(fields: [signalRunId], references: [id], onDelete: Cascade)
  signalIndex       Int
  code              String
  name              String
  assetType         String // 'stock' | 'etf'
  action            String // 'buy' | 'sell'
  requestedShares   Float
  refPrice          Float
  refAmount         Float
  source            String // 'target' | 'order'
  targetWeight      Float?
  simulatedStatus   String    @default("pending") // 'pending' | 'filled' | 'blocked'
  simulatedShares   Float?
  simulatedPrice    Float?
  simulatedFee      Float?
  simulatedSlippage Float?
  simulatedReason   String?
  actualStatus      String    @default("pending") // 'pending' | 'filled' | 'skipped'
  actualShares      Float?
  actualPrice       Float?
  actualFee         Float?
  actualReason      String?
  actualNote        String?
  actualRecordedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([signalRunId, signalIndex])
  @@index([userId, actualStatus])
  @@index([code, createdAt])
}

/// Rebuildable end-of-day shadow-account state. The first row for each deployment/kind is the frozen
/// model baseline; later rows are replayed from SignalExecution and raw market data.
model StrategyAccountSnapshot {
  id           String             @id // ULID
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deploymentId String
  deployment   StrategyDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  kind         String // 'simulation' | 'actual'
  tradeDate    String
  cash         Float
  marketValue  Float
  equity       Float
  positions    Json // AccountPositionSnapshot[]
  isBaseline   Boolean            @default(false)
  sourceRunId  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([deploymentId, kind, tradeDate])
  @@index([userId, kind, tradeDate])
  @@index([deploymentId, kind, isBaseline])
}

/// Immutable parameter-scan report. The strategy/config/spec snapshots make each explicit scan a
/// durable research record; the payload stores compact per-combination metrics, not full trade logs.
model StrategyScanReport {
  id           String   @id // ULID
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId   String
  strategy     Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyName String
  status       String // 'running' | 'done' | 'error' | 'stale'
  config       Json // frozen BacktestConfig
  spec         Json // StrategyScanSpec
  codeHash     String
  dataCutoff   String?
  payload      Json? // StrategyScanPayload
  error        String?
  job          Job?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, strategyId, createdAt])
  @@index([userId, status])
}

/// A factor as code (code-first, mirrors Strategy). `code` is a defineFactor TS module, compiled +
/// run cross-sectionally in the factor analysis. Two kinds of rows share this table:
///   - user factors: id = ULID, userId = the owner;
///   - built-in presets: id = stable slug (ep/mom/…), userId = 'builtin' sentinel — seeded from
///     factor/builtin-factors.ts (git is the source of truth), read-only via the routes.
/// Plain userId (no relation), like FactorReport.
model Factor {
  id            String              @id // ULID, or a preset slug for builtin rows
  userId        String
  key           String? // immutable strategy handle after finalization; null while a user factor is a draft
  keyCandidate  String? // LLM proposal, editable by the user until key is finalized
  name          String // canonical Chinese display name, refreshed from the factor context
  analysisKind  String              @default("cross_sectional") // immutable definition protocol
  descriptionZh String              @default("")
  descriptionEn String              @default("")
  code          String // defineFactor TS source
  messages      Json? // ChatMessage[] — the Agent-panel conversation that authored this factor (per-factor)
  conversations AgentConversation[]
  weatherPins   FactorWeatherPin[]
  releases      FactorRelease[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, key]) // user-factor keys are unique per owner; builtin keys are additionally reserved in the allocator
  @@index([userId, updatedAt]) // list a user's factors, newest first
}

/// One user-pinned immutable factor version monitored under the canonical monthly weather methodology.
/// The source snapshot and direction are frozen; editing requires a fork instead of mutating history.
model FactorWeatherPin {
  id              String               @id
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  factorId        String
  factor          Factor               @relation(fields: [factorId], references: [id], onDelete: Restrict)
  releaseId       String?
  release         FactorRelease?       @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  factorName      String
  builtin         Boolean
  direction       String // 'positive' | 'negative'
  factorCode      String
  factorCodeHash  String
  methodologyHash String
  status          String               @default("pending") // 'pending' | 'running' | 'ready' | 'error'
  error           String?
  computedThrough String?
  points          FactorWeatherPoint[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([userId, factorId])
  @@index([releaseId])
  @@index([status, updatedAt])
}

/// A compact realized monthly factor observation. It stores aggregate research diagnostics only;
/// per-security factor values remain ephemeral inside the sandboxed worker.
model FactorWeatherPoint {
  pinId                String
  pin                  FactorWeatherPin @relation(fields: [pinId], references: [id], onDelete: Cascade)
  formationDate        String
  periodEndDate        String
  rankIc               Float
  topReturn            Float
  bottomReturn         Float
  longShortGrossReturn Float
  longShortNetReturn   Float
  topTurnover          Float?
  sampleSize           Int
  sampleCoverage       Float
  createdAt            DateTime         @default(now())

  @@id([pinId, periodEndDate])
  @@index([periodEndDate])
}

/// A reusable multi-factor research definition. Reports freeze the full definition in specJson, so
/// editing or deleting this row never changes historical results.
model FactorComposite {
  id         String          @id // ULID
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  definition Json // FactorCompositeDefinitionV1
  releases   FactorRelease[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, updatedAt])
}

/// An explicitly published, immutable factor version. Editable source rows may be deleted without
/// invalidating the frozen definition and methodology that historical strategies referenced.
model FactorRelease {
  id                  String             @id
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  factorId            String?
  factor              Factor?            @relation(fields: [factorId], references: [id], onDelete: SetNull)
  compositeId         String?
  composite           FactorComposite?   @relation(fields: [compositeId], references: [id], onDelete: SetNull)
  sourceRef           String
  releaseKey          String
  version             Int
  sourceKind          String // 'single' | 'composite'
  sourceName          String
  inputDomains        Json
  targetAssetClasses  Json
  outputScope         String // 'asset' | 'global'
  codeSnapshot        String
  codeHash            String
  approvedReportId    String
  approvedReport      FactorReport       @relation(fields: [approvedReportId], references: [id], onDelete: Restrict)
  methodologySnapshot Json
  maturity            String // 'experimental' | 'validated' | 'production'
  lifecycle           String             @default("active") // 'active' | 'retired'
  weatherPins         FactorWeatherPin[]
  createdAt           DateTime           @default(now())

  @@unique([userId, releaseKey, version])
  @@index([userId, lifecycle, createdAt])
  @@index([factorId, createdAt])
  @@index([compositeId, createdAt])
  @@index([approvedReportId])
}

/// An agent conversation on the screen page (a "session card" on the card wall). Strategy/factor
/// conversations ride their host entity (Strategy.messages / Factor.messages); a screening
/// conversation has no host, so it gets its own row. Query cards (SavedScreen) are deliberately NOT
/// linked to conversations — deleting a conversation never touches saved cards.
model ScreenConversation {
  id        String   @id // ULID
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // defaults to the first user message, truncated; renamable
  messages  Json // ChatMessage[] (parts shape)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConversations AgentConversation[]

  @@index([userId, updatedAt])
}

/// A durable Agent conversation shared by the strategy, factor, and screen surfaces. During the
/// compatibility migration, legacy messages remain on their host rows and new turns dual-write here.
model AgentConversation {
  id                   String              @id // ULID
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface              String // 'strategy' | 'factor' | 'screen'
  title                String?
  strategyId           String?
  strategy             Strategy?           @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  factorId             String?
  factor               Factor?             @relation(fields: [factorId], references: [id], onDelete: Cascade)
  screenConversationId String?
  screenConversation   ScreenConversation? @relation(fields: [screenConversationId], references: [id], onDelete: Cascade)
  archivedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  messages AgentMessage[]
  turns    AgentTurn[]

  @@index([userId, updatedAt])
  @@index([userId, surface, updatedAt])
  @@index([strategyId])
  @@index([factorId])
  @@index([screenConversationId])
}

/// One durable user-visible message. Parts remain JSON because they form one atomic render payload.
model AgentMessage {
  id             String            @id // ULID
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // 'user' | 'assistant'
  parts          Json // MessagePart[]
  sequence       Int
  turnId         String?
  turn           AgentTurn?        @relation(fields: [turnId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@index([turnId])
}

/// One durable Agent execution. `trace` is the ordered, versioned record of model, tool, and
/// validation steps; the in-memory turn bus remains responsible only for live token delivery.
model AgentTurn {
  id             String            @id // ULID; identical to the public turnId
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         String // 'running' | 'done' | 'error' | 'cancelled' | 'interrupted'
  model          String
  trace          Json
  error          String?
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?

  messages AgentMessage[]

  @@index([conversationId, startedAt])
  @@index([status, startedAt])
}

/// A saved screen query (holds a ScreenSpec as JSON). Saved on demand — the user clicks "Save" to keep
/// an exploratory query; also upsert by name.
model SavedScreen {
  id        String   @id // ULID
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  spec      Json // ScreenSpec
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}
