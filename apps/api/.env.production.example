# Production env for the jixie API (loaded by systemd via EnvironmentFile).
# Copy to .env.production ON THE SERVER and fill real values. Never commit the real file.

# SQLite lives OUTSIDE the code dir so redeploys never touch it. This DB holds the whole market
# history — rebuilding it means a full Tushare backfill (hours-to-a-day, rate-limited). systemd grants
# write only to this dir (ReadWritePaths). See docs/deployment.md for seeding it.
DATABASE_URL="file:/var/lib/jixie/prod.db"

# Port the Hono server listens on (nginx reverse-proxies /api/ here).
PORT=3001

# Production mode: secure (HTTPS-only) cookies + NO dev console fallback for OTP.
# NOTE: secure cookies require the site be served over HTTPS, or the login session won't stick.
NODE_ENV=production

# Tushare token — REQUIRED. The app refuses to boot without it (config.ts throws), and it's what the
# daily market sync uses. Get it from https://tushare.pro (your account's token).
TUSHARE_TOKEN=""

# Email one-time login codes (Resend). In production the code is NOT logged to console, so a working
# key + a verified sender domain are required for anyone to log in.
RESEND_API_KEY=""
EMAIL_FROM=""

# DeepSeek (NL -> strategy/factor code, the Agent). Needed for the codegen / Agent features; the rest
# of the app works without it. BASE_URL / MODEL have sane defaults.
DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-chat"

# Tushare request throttle (ms between calls). Raise if you hit rate limits on a low-points account.
# TUSHARE_MIN_INTERVAL_MS=400

# How long maintenance waits for already-running backtests, factor jobs, scans, signals, and Agent
# turns before failing without changing market data.
# MAINTENANCE_JOB_DRAIN_TIMEOUT_MS=120000

# Require this many quiet milliseconds with no running work after the Gate is raised. This closes
# the small race with an HTTP request that passed the Gate immediately before maintenance started.
# MAINTENANCE_JOB_QUIET_MS=5000

# Daily may reuse the newest IndexWeight snapshot at or before the trade date, but rejects it once
# it is older than this many calendar days. Weekly maintenance normally keeps it much fresher.
# MAINTENANCE_INDEX_WEIGHT_MAX_AGE_DAYS=190

# Recheck this many already-published trading dates on every daily run. Deterministic defects in
# Daily/AdjFactor/DailyBasic/StkLimit/Moneyflow and major-index slices are repaired before signals.
# MAINTENANCE_DAILY_REPAIR_LOOKBACK_DAYS=5

# Weekly maintenance performs the same check over roughly one trading year. To keep an unexpected
# provider incident bounded, one run repairs at most this many dates and fails visibly if more are
# left; the next run resumes idempotently.
# MAINTENANCE_WEEKLY_REPAIR_LOOKBACK_DAYS=252
# MAINTENANCE_MAX_AUTO_REPAIR_DATES=20

# The initial full import checks this many completed trading dates before strict audit and watermark
# initialization. This catches partial resume markers and an incomplete publication baseline.
# MAINTENANCE_BASELINE_REPAIR_LOOKBACK_DAYS=20
