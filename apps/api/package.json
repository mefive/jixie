{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=development node_modules/vitest/vitest.mjs run",
    "test:watch": "node --conditions=development node_modules/vitest/vitest.mjs",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "backup": "node scripts/backup-db.mjs",
    "maintenance": "tsx --conditions=development --env-file=.env src/application-maintenance/cli/run-maintenance.ts",
    "signals:run": "tsx --conditions=development --env-file=.env src/signals/cli/run-signals.ts",
    "gen:invite": "tsx --conditions=development --env-file=.env src/auth/cli/gen-invite.ts",
    "canonicalize:stock-codes": "tsx --conditions=development --env-file=.env src/market/cli/canonicalize-stock-codes.ts",
    "sync": "node --conditions=development --import tsx scripts/sync/index.ts",
    "data:audit": "node --conditions=development --import tsx scripts/audit/index.ts",
    "probe": "node --conditions=development --import tsx scripts/probes/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.8.0",
    "@jixie/shared": "workspace:*",
    "@prisma/client": "^6.16.0",
    "dayjs": "^1.11.13",
    "esbuild": "^0.28.1",
    "fflate": "^0.8.2",
    "hono": "^4.9.0",
    "isolated-vm": "^7.0.0",
    "openai": "^6.44.0",
    "pyright": "1.1.411",
    "ulid": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "imports": {
    "#agent/*": {
      "development": "./src/agent/*",
      "default": "./dist/src/agent/*"
    },
    "#auth/*": {
      "development": "./src/auth/*",
      "default": "./dist/src/auth/*"
    },
    "#engine/*": {
      "development": "./src/engine/*",
      "default": "./dist/src/engine/*"
    },
    "#factor/*": {
      "development": "./src/factor/*",
      "default": "./dist/src/factor/*"
    },
    "#i18n/*": {
      "development": "./src/i18n/*",
      "default": "./dist/src/i18n/*"
    },
    "#infra/*": {
      "development": "./src/infra/*",
      "default": "./dist/src/infra/*"
    },
    "#application-maintenance/*": {
      "development": "./src/application-maintenance/*",
      "default": "./dist/src/application-maintenance/*"
    },
    "#market/*": {
      "development": "./src/market/*",
      "default": "./dist/src/market/*"
    },
    "#math/*": {
      "development": "./src/math/*",
      "default": "./dist/src/math/*"
    },
    "#research/*": {
      "development": "./src/research/*",
      "default": "./dist/src/research/*"
    },
    "#sharing/*": {
      "development": "./src/sharing/*",
      "default": "./dist/src/sharing/*"
    },
    "#signals/*": {
      "development": "./src/signals/*",
      "default": "./dist/src/signals/*"
    },
    "#strategy/*": {
      "development": "./src/strategy/*",
      "default": "./dist/src/strategy/*"
    },
    "#date": {
      "development": "./src/date.ts",
      "default": "./dist/src/date.js"
    }
  }
}
