# Prisma：相对路径相对 schema.prisma 解析，file:./dev.db 实际落在 apps/api/prisma/dev.db
DATABASE_URL="file:./dev.db"

# 默认 3001（避开 marginalia / fangtu 默认占用的 3000）
PORT=3001

# 可发布采集副本的管理员邮箱，多个邮箱用逗号分隔；变更后重启 API。
# Administrator emails permitted to publish candidates; comma-separated, effective after API restart.
# NODE_ENV=development 时，已登录用户也有发布权限。
# Signed-in users also have publication permission when NODE_ENV=development.
JIXIE_ADMIN_EMAILS=""

# Tushare token —— 注册 https://tushare.pro 后在「个人主页 → 接口 TOKEN」复制
TUSHARE_TOKEN=

# 可选：覆盖 Tushare API 地址（默认 http://api.tushare.pro）
# TUSHARE_BASE_URL=http://api.tushare.pro

# 并发下载与统一频次分开配置，默认 4 路、75 次/分钟，发起间隔至少 800ms。
# Configure concurrency separately from shared admission; defaults: 4 workers, 75/min, >=800ms starts.
# JIXIE_INGESTION_CONCURRENCY=4
# TUSHARE_REQUESTS_PER_MINUTE=75
# TUSHARE_MIN_INTERVAL_MS=800

# 每个 API 可另设分钟和滚动 24 小时上限；按实际权限配置，不自动推断积分档位。
# Optional per-API minute and rolling-day quotas; configure verified entitlements explicitly.
# TUSHARE_API_LIMITS_JSON='{"daily":{"perMinute":180,"perDay":100000}}'

# 默认在数据库旁 source-quotas 私有目录保存账号锁和配额账本；同账号的本地进程应共用路径。
# Private token locks and quota journals default beside the DB; local senders must share this directory.
# TUSHARE_QUOTA_DIRECTORY=/private/path/to/source-quotas

# 邮件验证码（Resend）。https://resend.com/api-keys 申请 key 并配置发件域名。
# 本地未配置（任一字段为空）且非生产时，验证码打印到后端控制台而非真发邮件。
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
# 可选：通知邮件中“打开今日信号”的站点地址，例如 https://jixie.example.com
# JIXIE_PUBLIC_URL=

# 每日信号调度：生产默认开启，开发默认关闭；显式 true/false 可覆盖。
# SIGNALS_SCHEDULER_ENABLED=false

# DeepSeek powers Agent conversations, code generation, metadata and naming.
# Get an API key at https://platform.deepseek.com; non-LLM features do not need it.
DEEPSEEK_API_KEY=""
# V4.1 Flash defaults; explicit model overrides are preserved, including old model IDs.
# DEEPSEEK_MODEL=deepseek-flash
# Agent model falls back to DEEPSEEK_MODEL, then deepseek-flash.
# DEEPSEEK_AGENT_MODEL=deepseek-flash
# Agent thinking is enabled by default (high effort); false explicitly disables it.
# JSON / naming calls always disable thinking, independently of the Agent setting.
# DEEPSEEK_AGENT_THINKING=true
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_BASE_URL=https://api.deepseek.com
