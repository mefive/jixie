# Prisma：相对路径相对 schema.prisma 解析，file:./dev.db 实际落在 apps/api/prisma/dev.db
DATABASE_URL="file:./dev.db"

# 默认 3001（避开 marginalia / fangtu 默认占用的 3000）
PORT=3001

# Tushare token —— 注册 https://tushare.pro 后在「个人主页 → 接口 TOKEN」复制
TUSHARE_TOKEN=

# 可选：覆盖 Tushare API 地址（默认 http://api.tushare.pro）
# TUSHARE_BASE_URL=http://api.tushare.pro

# 可选：两次请求最小间隔 ms（默认 400≈150次/分钟；账户低频额度 200/分钟）。
# 拉财务（80次/分钟）时需调大到 ≥750。
# TUSHARE_MIN_INTERVAL_MS=400

# 邮件验证码（Resend）。https://resend.com/api-keys 申请 key 并配置发件域名。
# 本地未配置（任一字段为空）且非生产时，验证码打印到后端控制台而非真发邮件。
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
# 可选：通知邮件中“打开今日信号”的站点地址，例如 https://jixie.example.com
# JIXIE_PUBLIC_URL=

# 每日信号调度：生产默认开启，开发默认关闭；显式 true/false 可覆盖。
# SIGNALS_SCHEDULER_ENABLED=false

# DeepSeek powers Agent conversations, code generation, metadata and naming.
# Get an API key at https://platform.deepseek.com; non-LLM features do not need it.
DEEPSEEK_API_KEY=""
# V4.1 Flash defaults; explicit model overrides are preserved, including old model IDs.
# DEEPSEEK_MODEL=deepseek-flash
# Agent model falls back to DEEPSEEK_MODEL, then deepseek-flash.
# DEEPSEEK_AGENT_MODEL=deepseek-flash
# Agent thinking is enabled by default (high effort); false explicitly disables it.
# JSON / naming calls always disable thinking, independently of the Agent setting.
# DEEPSEEK_AGENT_THINKING=true
# DEEPSEEK_REASONING_EFFORT=high
# DEEPSEEK_BASE_URL=https://api.deepseek.com
